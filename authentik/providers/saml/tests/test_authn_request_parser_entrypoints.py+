# authentik/providers/saml/tests/test_authn_request_parser_entrypoints.py

from base64 import b64encode
import zlib

from django.test import TestCase

from authentik.core.tests.utils import create_test_flow
from authentik.lib.generators import generate_id
from authentik.providers.saml.models import SAMLProvider, SAMLSP
from authentik.providers.saml.processors.authn_request_parser import AuthNRequestParser


NS_SAML_PROTOCOL = "urn:oasis:names:tc:SAML:2.0:protocol"
NS_SAML_ASSERTION = "urn:oasis:names:tc:SAML:2.0:assertion"


def saml_post_b64(xml: str) -> str:
    """HTTP-POST binding: base64 of raw XML bytes."""
    return b64encode(xml.encode("utf-8")).decode("ascii")


def saml_redirect_b64_deflate(xml: str) -> str:
    """HTTP-Redirect binding: base64 of raw-DEFLATE(XML). (no zlib header)"""
    comp = zlib.compressobj(wbits=-15)  # raw DEFLATE
    raw = comp.compress(xml.encode("utf-8")) + comp.flush()
    return b64encode(raw).decode("ascii")


class TestAuthNRequestParserEntrypoints(TestCase):
    def setUp(self):
        self.provider = SAMLProvider.objects.create(
            name=generate_id(),
            authorization_flow=create_test_flow(),
            acs_url="https://sp.example.com/saml/acs",
        )
        self.sp = SAMLSP.objects.create(
            provider=self.provider,
            name="Example SP",
            entity_id="https://sp.example.com/metadata",
            acs_url="https://sp.example.com/saml/acs",
            enabled=True,
        )

    def _xml(self) -> str:
        return f"""<?xml version="1.0" encoding="UTF-8"?>
<saml2p:AuthnRequest xmlns:saml2p="{NS_SAML_PROTOCOL}"
                    xmlns:saml2="{NS_SAML_ASSERTION}"
                    ID="req123"
                    Version="2.0"
                    IssueInstant="2020-01-01T00:00:00Z"
                    AssertionConsumerServiceURL="https://sp.example.com/saml/acs">
  <saml2:Issuer>{self.sp.entity_id}</saml2:Issuer>
</saml2p:AuthnRequest>
"""

    def test_parse_post_base64(self):
        """parse(): HTTP-POST style base64(xml)"""
        parser = AuthNRequestParser(self.provider)
        saml_request = saml_post_b64(self._xml())

        # parse(...) のシグネチャが違うならここだけ合わせて
        req = parser.parse(saml_request, relay_state=None)

        self.assertEqual(req.id, "req123")
        self.assertEqual(req.issuer, self.sp.entity_id)
        self.assertEqual(req.samlsp_pk, str(self.sp.pk))

    def test_parse_detached_redirect_deflate_base64(self):
        """parse_detached(): HTTP-Redirect style base64(deflate(xml))"""
        parser = AuthNRequestParser(self.provider)
        saml_request = saml_redirect_b64_deflate(self._xml())

        # 署名なしケース。実装側が signature パラメータ必須なら None の扱いだけ調整して
        req = parser.parse_detached(
            saml_request,
            relay_state=None,
            signature=None,
            sig_alg=None,
        )

        self.assertEqual(req.id, "req123")
        self.assertEqual(req.issuer, self.sp.entity_id)
        self.assertEqual(req.samlsp_pk, str(self.sp.pk))
